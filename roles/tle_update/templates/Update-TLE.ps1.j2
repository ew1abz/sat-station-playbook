# Update-TLE.ps1 — downloads fresh TLE data for Gpredict
# Generated by Ansible; do not edit by hand.

$dest = "$env:USERPROFILE\Gpredict\satdata"

if (-not (Test-Path $dest)) {
    New-Item -ItemType Directory -Path $dest | Out-Null
}

{% for source in tle_sources %}
try {
    Invoke-WebRequest -Uri "{{ source.url }}" -OutFile "$dest\{{ source.name }}.tle" -UseBasicParsing
    Write-Output "Updated {{ source.name }}.tle"
} catch {
    Write-Warning "Failed to update {{ source.name }}: $_"
}
{% endfor %}
